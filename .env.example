# Shared secret between DeepTutor and the bridge. Generate one:  openssl rand -hex 24
BRIDGE_API_KEY=

# Claude credential for the bridge (set one).
# Subscription token:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# or an API key:
ANTHROPIC_API_KEY=

# Which agent the bridge drives: claude (default) or antigravity.
ACP_AGENT=claude

# Antigravity (ACP_AGENT=antigravity): API key for the default gemini-api-key method.
GEMINI_API_KEY=
# Optional: another ACP auth method id (e.g. agent-platform).
ACP_AUTH_METHOD=
